<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card">
      <div class="card-header">
        <h2 class="mb-0">👤 プロフィール編集</h2>
      </div>
      <div class="card-body">
        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <div class="mb-3">
            <%= f.label :name, class: "form-label" %>
            <%= f.text_field :name, class: "form-control" %>
          </div>

          <div class="mb-3">
            <%= f.label :email, class: "form-label" %>
            <%= f.email_field :email, autocomplete: "email", class: "form-control" %>
          </div>

          <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
            <div class="alert alert-info">
              📧 現在、<%= resource.unconfirmed_email %>の確認待ちです
            </div>
          <% end %>

          <div class="mb-3">
            <%= f.label :password, "新しいパスワード", class: "form-label" %>
            <i>（変更しない場合は空欄）</i>
            <%= f.password_field :password, autocomplete: "new-password", class: "form-control" %>
            <% if @minimum_password_length %>
              <div class="form-text">最低<%= @minimum_password_length %>文字以上</div>
            <% end %>
          </div>

          <div class="mb-3">
            <%= f.label :password_confirmation, "新しいパスワード（確認）", class: "form-label" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %>
          </div>

          <div class="mb-3">
            <%= f.label :current_password, "現在のパスワード", class: "form-label" %>
            <i>（変更を確認するために現在のパスワードが必要です）</i>
            <%= f.password_field :current_password, autocomplete: "current-password", class: "form-control" %>
          </div>

          <div class="d-grid gap-2">
            <%= f.submit "更新する", class: "btn btn-primary" %>
          </div>
        <% end %>

        <hr>

        <h3>アカウントの削除</h3>
        <p>
          <%= button_to "アカウントを削除する", registration_path(resource_name),
                data: { confirm: "本当に削除しますか？", turbo_confirm: "本当に削除しますか？" },
                method: :delete,
                class: "btn btn-danger" %>
        </p>

        <%= link_to "← 戻る", :back, class: "btn btn-link" %>
      </div>
    </div>
  </div>
</div>
